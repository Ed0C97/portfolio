---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="404 · Edoardo Caciolo">
  <section class="section">
    <div class="container notfound">
      <p class="kicker">404</p>
      <h1 class="section-title">Page not found · Pagina non trovata</h1>
      <div class="actions">
        <a class="btn" href="/">Home (EN)</a>
        <a class="btn btn--ghost" href="/it/">Home (IT)</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: 80px;
  }

  .actions {
    margin-top: 32px;
    display: flex;
    gap: 14px;
  }
</style>
