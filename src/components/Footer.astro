---
import { useTranslations, type Lang } from '../i18n/ui';
import { identity } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container footer-grid">
    <div>
      <p class="mono footer-name">Edoardo Caciolo</p>
      <p class="muted footer-loc">{t('footer.location')}</p>
    </div>
    <nav class="footer-links" aria-label="Contact">
      <a href={`mailto:${identity.email}`}>{identity.email}</a>
      <a href={identity.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={identity.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
    <p class="muted footer-note">© {year} Edoardo Caciolo</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 72px;
    border-top: 1px solid color-mix(in srgb, var(--border-soft) 30%, transparent);
    padding-block: 40px;
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .footer-name {
    font-weight: 700;
    font-size: 15px;
  }

  .footer-loc {
    font-size: 13.5px;
    margin-top: 2px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    font-size: 14.5px;
    font-weight: 600;
  }

  .footer-links a {
    color: var(--text-muted);
    transition: color var(--transition);
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-note {
    font-size: 12.5px;
    width: 100%;
  }
</style>
